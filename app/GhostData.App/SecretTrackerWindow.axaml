<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GhostData.App.SecretTrackerWindow" Width="260" Height="400" Title="GhostData · Secrets" Topmost="True" CanResize="False" WindowDecorations="None" Background="{DynamicResource GcSurface}" ShowInTaskbar="False" ShowActivated="False" Focusable="False" WindowStartupLocation="Manual">
  <Border CornerRadius="10" BorderBrush="{DynamicResource GcHalo}" BorderThickness="1" Padding="9">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="7">
        <TextBlock Text="SECRETS" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource GcHalo}"/>
        <ItemsControl ItemsSource="{Binding PlayerSecrets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,3">
                <TextBlock Text="YOUR ACTIVE SECRET" FontSize="10" Foreground="{DynamicResource GcSage}"/>
                <TextBlock Text="{Binding Name}" FontSize="15" TextWrapping="Wrap"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding OpponentSecrets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,3" Padding="6" CornerRadius="5" Background="#102A38">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource GcSage}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource GcMuted}"/>
                  <ItemsControl ItemsSource="{Binding PreviewCandidates}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="15" TextWrapping="Wrap" Margin="0,2"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding EliminatedCandidates}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="15" TextWrapping="Wrap" Margin="0,2" Opacity="0.4" TextDecorations="Strikethrough"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
