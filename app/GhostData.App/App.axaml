<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GhostData.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://GhostData.App/Themes/GhostDataTheme.axaml" />
    <StyleInclude Source="avares://GhostData.App/Themes/DeckRailTheme.axaml" />
  </Application.Styles>
</Application>
